<Window x:Class="MaterialCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Calculator" Height="600" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        Foreground="{DynamicResource MaterialDesignBody}"
        ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="380">
            <!-- Display -->
            <TextBox Name="DisplayBox" 
                     Height="80"
                     FontSize="36"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     Padding="20"
                     Background="White"
                     Foreground="Black"
                     IsReadOnly="True"
                     Margin="0,0,0,20"
                     BorderThickness="0"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>

            <!-- Button Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <Button Content="C" Grid.Row="0" Grid.Column="0" Click="Clear_Click" Style="{StaticResource FunctionButton}"/>
                <Button Content="+/-" Grid.Row="0" Grid.Column="1" Click="ToggleSign_Click" Style="{StaticResource FunctionButton}"/>
                <Button Content="%" Grid.Row="0" Grid.Column="2" Click="Operator_Click" Style="{StaticResource FunctionButton}"/>
                <Button Content="÷" Grid.Row="0" Grid.Column="3" Click="Operator_Click" Style="{StaticResource OperatorButton}"/>

                <!-- Row 2 -->
                <Button Content="7" Grid.Row="1" Grid.Column="0" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="8" Grid.Row="1" Grid.Column="1" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="9" Grid.Row="1" Grid.Column="2" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="×" Grid.Row="1" Grid.Column="3" Click="Operator_Click" Style="{StaticResource OperatorButton}"/>

                <!-- Row 3 -->
                <Button Content="4" Grid.Row="2" Grid.Column="0" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="5" Grid.Row="2" Grid.Column="1" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="6" Grid.Row="2" Grid.Column="2" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="−" Grid.Row="2" Grid.Column="3" Click="Operator_Click" Style="{StaticResource OperatorButton}"/>

                <!-- Row 4 -->
                <Button Content="1" Grid.Row="3" Grid.Column="0" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="2" Grid.Row="3" Grid.Column="1" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="3" Grid.Row="3" Grid.Column="2" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="+" Grid.Row="3" Grid.Column="3" Click="Operator_Click" Style="{StaticResource OperatorButton}"/>

                <!-- Row 5 -->
                <Button Content="0" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Click="Number_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="." Grid.Row="4" Grid.Column="2" Click="Decimal_Click" Style="{StaticResource NumberButton}"/>
                <Button Content="=" Grid.Row="4" Grid.Column="3" Click="Equals_Click" Style="{StaticResource EqualsButton}"/>

                <!-- Row 6 -->
                <Button Content="Backspace" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Click="Backspace_Click" Style="{StaticResource FunctionButton}"/>
                <Button Content="√" Grid.Row="5" Grid.Column="2" Click="SquareRoot_Click" Style="{StaticResource FunctionButton}"/>
                <Button Content="1/x" Grid.Row="5" Grid.Column="3" Click="Reciprocal_Click" Style="{StaticResource FunctionButton}"/>
            </Grid>
        </StackPanel>
    </Grid>

    <Window.Resources>
        <Style x:Key="NumberButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E0E0E0"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#D0D0D0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style x:Key="OperatorButton" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1976D2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#1565C0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style x:Key="EqualsButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#45a049"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#3d8b40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style x:Key="FunctionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F57C00"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#E65100"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
